# Copy to .env.local for local development. On Vercel, add these under Project > Settings > Environment Variables.
# Never put real values in this file: it is committed to the repository.

# Resend (https://resend.com) - sends each booking by email
RESEND_API_KEY=
# Where booking emails go
BOOKING_NOTIFY_EMAIL=shereconnects@gmail.com
# Sender. Keep the default until a domain is verified in Resend.
BOOKING_FROM_EMAIL="SHE-CATION Bookings <bookings@hello.she-reconnects.net>"

# Google Sheet webhook (Apps Script web app URL, see docs/BOOKINGS.md)
SHEETS_WEBHOOK_URL=
# Any long random string; must match the SECRET in the Apps Script
SHEETS_WEBHOOK_SECRET=
